# =============================================================================
# CMS Platform Environment Variables
# =============================================================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ems

# Kafka (internal - no need to change)
KAFKA_HOSTS=kafka:29092

# Redis (internal - no need to change)
REDIS_HOST=redis
REDIS_PORT=6379

# GitLab Registry (for production deployment)
CI_REGISTRY_IMAGE=registry.gitlab.com/your-group/cms-platform
CI_COMMIT_SHORT_SHA=latest
